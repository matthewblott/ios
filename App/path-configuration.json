{
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "^/$"
      ],
      "properties": {
        "presentation": "replace_root",
        "hide_back_button": true
      }
    },
    {
      "patterns": [
        "^/auth/sign-in/?$"
      ],
      "properties": {
        "context": "modal",
        "presentation": "default"
      }
    },
    {
      "patterns": [
        "^/auth/verify.*$"
      ],
      "properties": {
        "context": "modal",
        "presentation": "default"
      }
    },
    {
      "patterns": [
        "^/[a-zA-Z0-9-]+/home/?$"
      ],
      "properties": {
        "presentation": "replace_root",
        "hide_back_button": true
      }
    },
    {
      "patterns": [
        "^/[a-zA-Z0-9-]+/account/register/?$"
      ],
      "properties": {
        "context": "modal",
        "presentation": "default"
      }
    },
    {
      "patterns": [
        "^/[a-zA-Z0-9-]+/account/verify.*$"
      ],
      "properties": {
        "context": "modal",
        "presentation": "default"
      }
    },
    {
      "patterns": [
        "^/[a-zA-Z0-9-]+/account/rename/?$"
      ],
      "properties": {
        "context": "modal",
        "presentation": "default"
      }
    },
    {
      "patterns": [
        "^/[a-zA-Z0-9-]+/account/sign-out/?$"
      ],
      "properties": {
        "context": "modal",
        "presentation": "default"
      }
    },
    {
      "patterns": [
        "^/[a-zA-Z0-9-]+/account/delete/?$"
      ],
      "properties": {
        "context": "modal",
        "presentation": "default"
      }
    },
    {
      "patterns": [
        "^/[a-zA-Z0-9-]+/workouts/?$"
      ],
      "properties": {
        "presentation": "default"
      }
    },
    {
      "patterns": [
        "^/[a-zA-Z0-9-]+/workouts/[0-9]+/exercises/?$"
      ],
      "properties": {
        "presentation": "default"
      }
    },
    {
      "patterns": [
        "^(/[a-zA-Z0-9-]+)*/new/?$"
      ],
      "properties": {
        "context": "modal",
        "presentation": "default"
      }
    }
  ]
}

